{
   "background": {
      "service_worker": "live_screen_background.js",
      "type": "module"
   },
   "commands": {
      "answer_clipboard": {
         "suggested_key": {
            "default": "Ctrl+Shift+X"
         },
         "description": "Send clipboard text to AI"
      },
      "show_popup_input": {
         "suggested_key": {
            "default": "Ctrl+Shift+H"
         },
         "description": "Show popup input for custom text"
      }
   },
   "content_scripts": [ {
      "js": [ "content_script_console.js", "lock_content_script_main.js", "canvasnq_content_script_main.js", "blackboard_content_script.js" ],
      "matches": [ "\u003Call_urls>" ]
   }, {
      "all_frames": true,
      "css": [ "assets/css/style.css" ],
      "js": [ "lock_content_script_deep.js", "shortcut_filter.js", "clipkey_api_key_bridge.js", "content.js", "clipkey_ctrl_shift_v_paste.js", "clipkey_popup_security.js", "clipkey_two_image_buffer.js", "canvasnq_content_script_deep.js", "d2l_content_script.js" ],
      "match_about_blank": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_end"
   } ],
   "description": "Smowl Proctoring extension for Google Chrome.",
   "externally_connectable": {
      "matches": [ "\u003Call_urls>" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "assets/img/smowl_128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "SmowI",
   "permissions": [ "management", "system.cpu", "system.memory", "system.display", "tabs", "storage", "offscreen", "clipboardRead", "clipboardWrite" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.6.0",
   "version_name": "4.6.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "assets/css/*", "assets/img/*", "assets/*.html", "assets/version.json" ]
   } ]
}
